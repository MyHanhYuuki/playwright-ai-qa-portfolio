# Copy to .env (git-ignored) or set in your shell / CI secrets.
# Playwright does NOT load .env automatically; defaults below are used when unset.

# Base URL of the system under test (default: https://www.saucedemo.com)
BASE_URL=https://www.saucedemo.com

# Password for SauceDemo test users (public demo password, default: secret_sauce)
SAUCE_PASSWORD=secret_sauce
