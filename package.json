{
  "name": "playwright-ai-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript test automation portfolio driven by an AI agent QA pipeline (Claude Code + Playwright MCP)",
  "license": "UNLICENSED",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:run": "node scripts/run-tests.mjs",
    "test:evidence": "node scripts/run-evidence.mjs",
    "test:stability": "node scripts/run-stability.mjs",
    "report": "playwright show-report",
    "rtm": "node scripts/build-rtm.mjs",
    "typecheck": "tsc --noEmit",
    "repro": "playwright test --config=playwright.repro.config.ts"
  },
  "keywords": [
    "playwright",
    "typescript",
    "qa-automation",
    "e2e-testing",
    "ai-agents"
  ],
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
